# Copie para .env e preencha. O .env nunca vai para o git.

# --- Groq (obrigatorio para os textos; o resto do sistema roda sem) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURA=0.3

# --- Serial ---
# macOS: /dev/cu.usbserial-XXXX   Linux: /dev/ttyUSB0
# Se estiver errado ou vazio, o collector procura a porta sozinho.
SERIAL_PORT=
SERIAL_BAUD=9600

# --- Regras ---
LEITURAS_CONFIRMA=3
TEMP_ABORTO=32
TEMP_GEADA=3
JANELA_PADRAO_MIN=5

# --- Luminosidade ---
# O LDR devolve 0-1023. LUZ_INVERTIDA=1 quando valor MAIOR significa MENOS luz
# (LDR no ramo de cima do divisor). Confira tapando o sensor com a mao:
# se o numero sobe, esta invertido.
LUZ_INVERTIDA=1
LUZ_DIA_LUX=500
LUZ_LUX_MIN=1
LUZ_LUX_MAX=100000
